OUTPUT_ARCH("loongarch")
OUTPUT_FORMAT("elf64-loongarch")
ENTRY(__start)

MEMORY
{
  ram (rwx) : ORIGIN = 0x9000000000000000, LENGTH = 256M
}

SECTIONS
{
  . = ORIGIN(ram);
  .vectors :
  {
    _svectors = .;
    KEEP(*(.vectors.merr))
    . = ORIGIN(ram) + 0x1000;
    KEEP(*(.vectors.tlb))
    . = ORIGIN(ram) + 0x2000;
    KEEP(*(.vectors.eentry))
    /*. = ORIGIN(ram) + 0x5000; */
    . = ALIGN(4096);
    _evectors = .;
  } > ram

  /* kernel text start offset 1M */
  /*. = ORIGIN(ram) + 0x100000; */
  .text :
  {
    _stext = .;

    KEEP(*(.text.start))
    *(.text .text.*)
    *(.stub)
    *(.gnu.linkonce.t.*)
    *(.gnu.warning)

    . = ALIGN(16);
    _etext = .;
  } > ram

  .init_section :
  {
    . = ALIGN(16);
    _sinit = .;
    KEEP(*(.init_array .init_array.*))
    KEEP(*(.ctors))
    . = ALIGN(16);
    _einit = .;
  } > ram

  /* Read-only data (constants, strings) */
  .rodata :
  {
    . = ALIGN(16);
    _srodata = .;
    *(.rodata .rodata.*)
    *(.gnu.linkonce.r.*)
    *(.rodata1)
    . = ALIGN(16);
    _erodata = .;
  } > ram

  _eronly = .;

  /* KASAN shadow ram/global var */
  .kasan.global :
  {
    . = ALIGN(16);
    *(.data..LASANLOC*)
    KEEP (*(.data..LASAN0))
    KEEP (*(.data.rel.local..LASAN0))
    *(.kasan.shadows)
    . = ALIGN(16);
  } > ram

  /* Data section: initialised data, will be copied from ROM if needed */
  .data :
  {
    . = ALIGN(16);
    _sdata = .;
    *(.data .data.*)
    *(.gnu.linkonce.d.*)
    *(.data1)
    *(.data.rel.ro)
    *(.data.rel.ro.*)
    *(.got)
    *(.got.plt)
    *(.sdata .sdata.*)
    *(.gnu.linkonce.s.*)
    *(.sdata2 .sdata2.*)
    . = ALIGN(16);
    _edata = .;
  } > ram

  /* BSS: uninitialised data, zeroed at startup */
  .bss :
  {
    . = ALIGN(16);
    _sbss = .;
    *(.sbss .sbss.*)
    *(.gnu.linkonce.sb.*)
    *(.bss .bss.*)
    *(.gnu.linkonce.b.*)
    *(COMMON)
    . = ALIGN(16);
    _ebss = .;
  } > ram

  /*
  .initstack :
  {
    . = ALIGN(16);
    _s_initstack = .;
    *(.initstack)
    . = ALIGN(4096);
    g_idle_topstack = .;
    _e_initstack = .;
  } > ram
  */

  /* image end symbal, IDLE thread stack will grow upward from this address */
  . = ALIGN(4096);
  _end = .;

  /DISCARD/ :
  {
    *(.note.GNU-stack)
    *(.gnu.attributes)
    *(.comment)
  }
}
