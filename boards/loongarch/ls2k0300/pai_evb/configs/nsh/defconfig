# Architecture configuration
CONFIG_ARCH="loongarch"
CONFIG_ARCH_LOONGARCH=y
CONFIG_ARCH_CHIP="ls2k0300"
CONFIG_ARCH_CHIP_LS2K0300=y
CONFIG_ARCH_BOARD="pai_evb"
CONFIG_ARCH_BOARD_LS2K0300_PAI_EVB=y

# Build configuration - FLAT mode
CONFIG_BUILD_FLAT=y

# Processor configuration
CONFIG_ARCH_64BIT=y
CONFIG_ARCH_INTERRUPTSTACK=4096
CONFIG_IDLETHREAD_STACKSIZE=4096
CONFIG_SYSTEM_NSH=y
CONFIG_NSH_LIBRARY=y
CONFIG_INIT_ENTRYPOINT="nsh_main"

CONFIG_DISABLE_ALL_SIGNALS=y

# Memory configuration
CONFIG_RAM_START=0x9000000000000000
CONFIG_RAM_END=0x9000000010000000

# No FPU support
CONFIG_ARCH_FPU=n

# Interrupt configuration
#CONFIG_HAVE_NESTED_INTERRUPTS=y

# System Configuration
CONFIG_MSEC_PER_TICK=10
CONFIG_RR_INTERVAL=100
CONFIG_BOARD_LOOPSPERMSEC=1000

# Driver configuration
CONFIG_ARCH_HAVE_UART=y
CONFIG_UART0_ENABLED=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_UART0_BAUD=115200
CONFIG_UART0_BITS=8
CONFIG_UART0_PARITY=0
CONFIG_UART0_STOPBITS=1
CONFIG_UART0_RXBUFSIZE=16
CONFIG_UART0_TXBUFSIZE=16

# Task/thread configuration
#CONFIG_PREALLOC_TIMERS=4
#CONFIG_PREALLOC_WDOGS=2

# Networking (optional)
#CONFIG_NET=n

# File system (optional)
#CONFIG_FS_ROMFS=y

# Debug configuration
CONFIG_DEBUG_ALERT=y
CONFIG_DEBUG_FEATURES=n

# Application configuration
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_CONSOLE=y

# Toolchain configuration
CONFIG_ARCH_TOOLCHAIN_GNU=y
