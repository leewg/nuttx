STARTUP_OBJS = crt0$(OBJEXT)

# Specify our general Assembly files
#CMN_ASRCS += la64_exception.S
CMN_ASRCS += la64_saveusercontext.S
CMN_ASRCS += la64_vectors.S la64_tlb_refill.S la64_fatal.S

# Specify C code within the common directory to be included
CMN_CSRCS += la64_allocateheap.c la64_createstack.c la64_getintstack.c
CMN_CSRCS += la64_initialize.c la64_initialstate.c
CMN_CSRCS += la64_releasestack.c la64_stackframe.c la64_usestack.c
CMN_CSRCS += la64_idle.c la64_exit.c la64_switchcontext.c
CMN_CSRCS += la64_nputs.c la64_registerdump.c
CMN_CSRCS += la64_stable_timer.c

CMN_CSRCS += la64_exception.c la64_doirq.c la64_swint.c
CMN_CSRCS += la64_percpu.c

CMN_CSRCS += la64_debug.c

CMN_CSRCS += la64_sigdeliver.c la64_schedulesigaction.c
